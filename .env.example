# Copy to .env (optional). Defaults work out of the box for local Docker Compose.

# --- Local database ---
POSTGRES_USER=pse
POSTGRES_PASSWORD=pse
POSTGRES_DB=pse

# --- Host ports ---
DB_PORT=5433
FRONTEND_PORT=3000
BACKEND_PORT=8000
MLFLOW_PORT=5000

# Public MLflow URL shown on the model card (as seen from your browser).
MLFLOW_PUBLIC_URL=http://localhost:5000
# Size of the held-out evaluation window, in days
TEST_DAYS=60

